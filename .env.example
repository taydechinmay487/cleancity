# Copy to .env and fill in. Never commit real values.

# ---- Supabase project (Dashboard -> Project Settings -> API Keys) ----------
# Project URL without the trailing /rest/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key: shipped to the browser, protected by row level security
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Worker secrets (never exposed to the browser) -------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Secret / service_role key: used only by worker/index.js to drain the mail queue
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Email notifications (optional) ---------------------------------------
# Workers cannot open SMTP sockets, so mail goes out through Resend over HTTPS.
# Leave blank and every message is logged and recorded as "logged" instead.
RESEND_API_KEY=
MAIL_FROM=CleanCity <onboarding@resend.dev>

# Public origin used inside notification emails
APP_ORIGIN=http://127.0.0.1:5173

# Reserved for future SMS / WhatsApp delivery (stored on the notification row)
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_KEY=
